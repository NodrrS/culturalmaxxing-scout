# Copy to scout/.env and fill in. scout/.env is never committed.

# Nebius Token Factory: https://tokenfactory.nebius.com  (API keys)
NEBIUS_API_KEY=

# Tavily: https://app.tavily.com  (API keys)
TAVILY_API_KEY=

# Shown to every shop whose site is read, so they can reach you.
# Use a project address, not a personal one.
CMX_BOT_CONTACT=

# Only if `python3 scout/cli.py check` tells you to change them.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# OpenStreetMap needs no key. Change these only to use other servers.
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
