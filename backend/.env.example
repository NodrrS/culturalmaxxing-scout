# REST API Template Environment Variables
# Copy this file to .env.local for local development

# Server Configuration default
SERVER_PORT=8000
HOST=0.0.0.0
RELOAD=false
WORKERS=1

# Security Keys (replace with actual keys in production)
E_PRIVATE_KEY=your_private_key_here
E_PRIVATE_PASSWORD=your_private_password_here
E_PUBLIC_KEY=your_public_key_here

# Database Configuration (uncomment if using database)
# POSTGRES_DB=api_db
# POSTGRES_USER=api_user
# POSTGRES_PASSWORD=api_password
# DATABASE_URL=postgresql://api_user:api_password@postgres:5432/api_db

# Redis (optional — set REDIS_ENABLED=true to activate)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info

# API Configuration
API_TITLE=REST API Template
API_VERSION=1.0.0
API_DESCRIPTION=A template for building REST APIs with FastAPI